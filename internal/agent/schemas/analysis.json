{
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements", "recommendation", "reasons", "missing_evidence"],
  "properties": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence", "explanation"],
        "properties": {
          "id": {"type": "string"},
          "status": {"type": "string", "enum": ["met", "not_met", "missing_evidence"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "explanation": {"type": "string", "minLength": 1}
        }
      }
    },
    "recommendation": {"type": "string", "enum": ["fight", "accept"]},
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "evidence", "rules"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "rules": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "missing_evidence": {"type": "array", "items": {"type": "string"}}
  }
}
