{
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "network", "reason_code", "amount", "currency", "transaction_id", "transaction_date", "opened_at", "respond_by", "cardholder_claim"],
  "properties": {
    "case_id": {"type": "string", "minLength": 3},
    "network": {"type": "string", "enum": ["visa", "mastercard"]},
    "reason_code": {"type": "string", "minLength": 1},
    "amount": {"type": "string", "pattern": "^[0-9][0-9,]*(\\.[0-9]{1,3})?$"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "transaction_id": {"type": "string", "minLength": 1},
    "transaction_date": {"type": "string", "format": "date"},
    "opened_at": {"type": "string", "format": "date"},
    "respond_by": {"type": ["string", "null"], "format": "date"},
    "cardholder_claim": {"type": "string"}
  }
}
