# Copy to .env (docker compose reads it) or export the variables.

# OpenAI or any OpenAI-compatible API
OPENAI_API_KEY=
# LLM_MODEL=gpt-4.1-mini
# LLM_BASE_URL=https://api.openai.com/v1
# Use json_object for compatible servers without JSON schema support
# LLM_JSON_MODE=json_schema

# Local model instead (no key):
#   LLM_PROVIDER=ollama docker compose --profile ollama up --build
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b

# Embeddings: openai, ollama, or hash (offline, weaker retrieval)
# EMBED_PROVIDER=

# Webhook HMAC secret (the seed tool signs with the same value)
# WEBHOOK_SECRET=local-dev-secret
